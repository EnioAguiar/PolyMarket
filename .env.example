# Polymarket Bot - Environment Variables
# Copy to .env and fill in values

# === Research APIs (opcionais — só usadas pelo pipeline de research, npm run validate-research) ===
# NewsData.io - Real-time news (free tier: 500/day)
# Sign up at: https://newsdata.io
NEWSDATA_API_KEY=

# X (Twitter) API v2 - Social media research (free tier)
# Sign up at: https://developer.twitter.com
# Get Bearer Token from: https://developer.twitter.com/en/apps
TWITTER_BEARER_TOKEN=

# Google Custom Search (usado por src/research/google.ts)
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Reddit API (usado por src/config/research.ts)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# CoinGecko (usado por src/research/sources/coingecko.ts) — opcional, funciona sem chave com rate limit menor
COINGECKO_API_KEY=

# RapidAPI / API-Football (usado por src/research/sources/football.ts)
RAPIDAPI_KEY=
RAPIDAPI_HOST=

# Caminho do binário Python usado pelos scrapers (Crawl4AI, Tweepy, PRAW) — default "python3"
PYTHON_BIN=

# === AI ===
# TypeSafe/Jev — usado só pelo pipeline de research (src/ai/jev.ts), não pelo caminho de
# decisão de trading real. Substituiu MiniMax nesta sessão (22/set/2026) — a conta MiniMax
# cotada antes não tinha plano/crédito ativo.
TYPESAFE_API_KEY=

# === Proxy (SOCKS5) ===
# SOCKS5 proxy URL (e.g. socks5h://user:pass@host:port). Read explicitly by
# src/index.ts (bot de trading) e src/research/whale-signal.ts (whale-monitor) via
# ProxyAgent's getProxyForUrl — deliberately NOT named HTTP_PROXY/HTTPS_PROXY, because
# axios (used internally by @polymarket/clob-client-v2) auto-detects those two exact
# names and applies its own HTTP-CONNECT-only proxy handling, which silently breaks on a
# socks5h:// URL regardless of any custom agent patched in. Confirmed by
# live testing this session: setting HTTP_PROXY/HTTPS_PROXY as literal env
# vars broke CLOB auth every time, with or without a custom agent; renaming
# to POLYMARKET_PROXY_URL and reading it explicitly fixed it immediately.
POLYMARKET_PROXY_URL=

# === Wallet (Polymarket trading) ===
PRIVATE_KEY=
# Deposit Wallet account address — copy it from polymarket.com's profile menu
# after connecting via MetaMask. This is NOT your MetaMask/EOA address, and
# it cannot be computed locally (confirmed this session: local derivation via
# @polymarket/builder-relayer-client gave 3 different wrong addresses across
# all 3 known wallet-type shapes). It's a required variable, not optional —
# src/api/clob.ts throws on startup if it's missing.
DEPOSIT_WALLET_ADDRESS=

# === Telegram Bot ===
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID that receives bot status/error/bet notifications (src/api/telegram.ts).
# Without it, every notification silently fails (sent to chat "", swallowed by a
# .catch) — including the geoblock alert. Get it by messaging @userinfobot on Telegram.
TELEGRAM_CHAT_ID=

# === Runtime / infra (opcionais, têm default sensato) ===
# RPC Polygon custom, sobrepõe o primeiro da lista de fallback em src/api/http.ts
POLYGON_RPC_URL=
# Onde persistir o estado do Safety Module entre restarts (src/safety/persistence.ts).
# Default "data/safety-state.json" — no Railway, aponte pro volume: /data/safety-state.json
SAFETY_STATE_FILE=
# Porta HTTP do servidor do bot (src/index.ts) — Railway injeta automaticamente
PORT=
# Diretório de trabalho dos scripts de push do banco (src/db/push.ts)
DATA_DIR=

# === Whale Monitor (src/whale-monitor/, serviço Railway separado — ver README Sub-projeto 5) ===
# Mesmo proxy do bot acima — evita rate-limit por IP compartilhado do Railway
# POLYMARKET_PROXY_URL já declarada acima cobre esse serviço também
# Protege /stats e /download com ?token=<valor> — opcional, sem ela os endpoints ficam abertos
MONITOR_TOKEN=
# Caminho do SQLite — default /data/polymarket.db (mesmo default do bot; recomendo
# setar explícito, ex. /data/whale-monitor.db, já que são volumes de serviços diferentes)
DB_PATH=
# Limiar mínimo de aposta considerada "whale bet", em USD — default 20000
MIN_BET_USD=
