# Polymarket Bot - Environment Variables
# Copy to .env and fill in values

# === Research APIs ===
# NewsData.io - Real-time news (free tier: 500/day)
# Sign up at: https://newsdata.io
NEWSDATA_API_KEY=

# X (Twitter) API v2 - Social media research (free tier)
# Sign up at: https://developer.twitter.com
# Get Bearer Token from: https://developer.twitter.com/en/apps
TWITTER_BEARER_TOKEN=

# === AI ===
MINIMAX_API_KEY=

# === Wallet (Polymarket trading) ===
PRIVATE_KEY=
# Deposit Wallet account address — copy it from polymarket.com's profile menu
# after connecting via MetaMask. This is NOT your MetaMask/EOA address, and
# it cannot be computed locally (confirmed this session: local derivation via
# @polymarket/builder-relayer-client gave 3 different wrong addresses across
# all 3 known wallet-type shapes). It's a required variable, not optional.
DEPOSIT_WALLET_ADDRESS=

# === Telegram Bot ===
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
